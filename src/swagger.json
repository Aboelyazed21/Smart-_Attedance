{
  "openapi": "3.0.0",
  "info": {
    "title": "Smart Attendance API Documentation",
    "version": "1.0.0",
    "description": "OpenAPI Spec linked with smart_attendance_db schema"
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "تسجيل الدخول للنظام",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "identifier": { "type": "string", "example": "admin@smartattendance.com" },
                  "password": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "تم تسجيل الدخول بنجاح" },
          "401": { "description": "بيانات الدخول غير صحيحة" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "email": { "type": "string" },
          "role_id": { "type": "integer" },
          "status": { "type": "string", "enum": ["active", "inactive", "suspended"] }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "course_code": { "type": "string", "example": "CS201" },
          "course_name": { "type": "string", "example": "Data Structures" }
        }
      },
      "AttendanceSession": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "section_id": { "type": "integer" },
          "status": { "type": "string", "enum": ["scheduled", "active", "closed", "cancelled"] },
          "qr_rotation_seconds": { "type": "integer", "example": 10 }
        }
      }
    }
  }
}